{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dentalis-pms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Static assets emitted by `opennextjs-cloudflare build` (client JS/CSS,
  // public/ files, etc.), served by Cloudflare's Asset Worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Non-secret runtime vars. Secrets (SUPABASE_SERVICE_ROLE_KEY,
  // NEXT_PUBLIC_SUPABASE_ANON_KEY, UPSTASH_REDIS_URL, UPSTASH_REDIS_TOKEN)
  // are NOT set here — set them in the dashboard (Worker → Settings →
  // Variables and Secrets) or via `wrangler secret put <NAME>`.
  //
  // DEFAULT_CLINIC_SLUG only applies on *.workers.dev and localhost (no
  // clinic subdomain there) — it picks which clinic the test URL serves.
  // It never affects <slug>.healthhub.app. See middleware.ts.
  "vars": {
    "DEFAULT_CLINIC_SLUG": "my-clinic",
    "NEXT_PUBLIC_APP_DOMAIN": "healthhub.app",
    "NEXT_PUBLIC_SUPABASE_URL": "https://apuxomkxwtjcoaqjhlux.supabase.co",
    "TZ": "Asia/Kolkata",
    "RATE_LIMIT_MAX": "3",
    "RATE_LIMIT_WINDOW_MS": "3600000"
  }
}
