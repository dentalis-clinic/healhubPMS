generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum SubmissionSource {
  PATIENT
  ADMIN
}

// DEPRECATED: Use bookingChannel + visitType instead
enum AppointmentType {
  PATIENT_BOOKING
  WALK_IN
  FOLLOW_UP
}

enum BookingChannel {
  ONLINE      // Patient used web form
  PHONE       // Patient called, admin transcribed
  WALK_IN     // Patient arrived without prior booking
  SMS         // Future: SMS booking
  WHATSAPP    // Future: WhatsApp booking
}

enum VisitType {
  NEW_CONSULTATION  // First visit or new issue
  FOLLOW_UP         // Continuing previous treatment
}

enum AppointmentStatus {
  PENDING     // Appointment booked, awaiting patient arrival (was TENTATIVE)
  OVERDUE     // Scheduled time passed, patient didn't show up
  CONFIRMED   // Patient arrived, treatment in progress
  COMPLETED   // Treatment finished
  CANCELLED   // Appointment cancelled (manual or auto)
  TENTATIVE   // DEPRECATED: Keep for migration compatibility
}

enum AppointmentPriority {
  ROUTINE     // Standard appointment
  URGENT      // Needs attention soon
  EMERGENCY   // Same-day critical care
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  WAIVED
  OTHER
}

// --- Models ---

/// Clinic entity — one row per tenant.
model Clinic {
  id        String   @id @default(uuid())
  slug      String   @unique // subdomain: ddcj.healthhub.app → "ddcj"
  name      String
  shortName String   // patient ID prefix, e.g. "DDCJ"
  timezone  String   @default("Asia/Kolkata")
  address   Json?    // { line1, line2, city, state, pincode }
  phones    String[]
  email     String?
  website   String?
  logo          String?  // path or URL
  businessHours Json?    // [{ start: "HH:mm", end: "HH:mm" }]
  slotDuration  Int?     // minutes per slot (null = 30)
  isActive      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patients           Patient[]
  appointments       Appointment[]
  doctors            Doctor[]
  payments           Payment[]
  prescriptions      Prescription[]
  printableTemplates printable_templates[]
  admins             Admin[]

  @@map("clinics")
}

/// Permanent person record. One patient = one clinic-scoped ID, many appointments.
model Patient {
  id          String    @id @default(uuid())
  clinicId    String
  patientId   String    @unique // DDCJ-YYYYMMDD-XXXX (generated once, permanent)
  name        String
  phone       String    // 10-digit Indian mobile, normalized
  email       String?
  age         Int?
  sex         Sex?
  address     String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]

  @@index([clinicId])
  @@index([phone])
  @@index([patientId])
  @@map("patients")
}

/// Visit/booking event linked to a patient.
model Appointment {
  id                String            @id @default(uuid())
  clinicId          String
  appointmentId     String            // APT-YYYYMMDD-XXXX (generated once, permanent; unique per clinic)
  patientId         String

  // NEW: Separate channel and visit type (replaces conflated `type`)
  bookingChannel    BookingChannel
  visitType         VisitType
  priority          AppointmentPriority?

  // DEPRECATED: Keep for migration compatibility, will be removed later
  type              AppointmentType?

  status            AppointmentStatus @default(PENDING)
  preferredDateTime DateTime
  reasonForVisit    String?           @db.Text
  submittedBy       SubmissionSource
  adminUserId       String?
  doctorId          String?
  notes             String?           @db.Text
  totalAmount       Decimal?          @db.Decimal(10, 2) // amountDue (after discount)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  admin        Admin?        @relation("appointmentAdmin", fields: [adminUserId], references: [id])
  doctor       Doctor?       @relation("appointmentDoctor", fields: [doctorId], references: [id])
  prescription Prescription?
  payments     Payment[]

  @@unique([clinicId, appointmentId])
  @@index([clinicId])
  @@index([appointmentId])
  @@index([patientId])
  @@index([status])
  @@index([preferredDateTime])
  @@index([preferredDateTime, status]) // Composite: "upcoming" tab (date + non-cancelled)
  @@index([createdAt])
  @@index([bookingChannel])
  @@index([visitType])
  @@index([doctorId])
  @@map("appointments")
}

/// Treatment record. One per appointment. Prescription generation confirms the appointment.
model Prescription {
  id             String    @id @default(uuid())
  clinicId       String
  prescriptionId String    @unique // RX-YYYYMMDD-XXXX
  appointmentId  String    @unique // 1:1 with appointment
  diagnosis      String    @db.Text
  medications    Json      // [{drugName, dosage, frequency, duration}]
  treatmentPlan  String?   @db.Text
  nextVisitDate  DateTime? @db.Date
  advice         String?   @db.Text
  prescribedById String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  clinic       Clinic      @relation(fields: [clinicId], references: [id])
  appointment  Appointment @relation(fields: [appointmentId], references: [id])
  prescribedBy Admin       @relation("prescriber", fields: [prescribedById], references: [id])

  @@index([clinicId])
  @@index([prescriptionId])
  @@map("prescriptions")
}

/// Doctor profile. Separate from Admin — doctors don't need login credentials.
model Doctor {
  id                 String   @id @default(uuid())
  clinicId           String
  name               String
  qualifications     String?
  registrationNumber String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[] @relation("appointmentDoctor")

  @@index([clinicId])
  @@map("doctors")
}

/// Individual payment transaction against an appointment's bill.
/// Multiple entries per appointment support partial payments and waivers.
model Payment {
  id            String        @id @default(uuid())
  clinicId      String
  appointmentId String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  recordedById  String
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())

  clinic       Clinic      @relation(fields: [clinicId], references: [id])
  appointment  Appointment @relation(fields: [appointmentId], references: [id])
  recordedBy   Admin       @relation("paymentRecorder", fields: [recordedById], references: [id])

  @@index([clinicId])
  @@index([appointmentId])
  @@index([paidAt])
  @@index([recordedById])
  @@map("payments")
}

enum TemplateType {
  DOCUMENT
  SURVEY
}

/// Custom printable document template (consent forms, post-treatment instructions, screening surveys, etc.)
model printable_templates {
  id                 String       @id @default(uuid())
  clinicId           String
  title              String
  templateType       TemplateType @default(DOCUMENT)
  showPatientDetails Boolean      @default(false)
  content            String       @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@map("printable_templates")
}

/// Admin/Doctor user. ID matches Supabase auth.users.id.
model Admin {
  id        String   @id // From Supabase auth.users (shared UUID)
  clinicId  String
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  appointments  Appointment[]  @relation("appointmentAdmin")
  prescriptions Prescription[] @relation("prescriber")
  payments      Payment[]      @relation("paymentRecorder")

  @@index([clinicId])
  @@map("admins")
}
